{
  "name": "for-club-freedom-2025",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "auth:generate": "pnpx @better-auth/cli generate --config convex/betterAuth/auth.ts --output convex/betterAuth/generatedSchema.ts",
    "build:preview": "vp build --mode preview && tsc --noEmit",
    "build": "vp build && tsc --noEmit",
    "cf-typegen": "wrangler types",
    "check": "vp check",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:preview": "pnpm run build && wrangler deploy --env preview",
    "deploy:production": "pnpm run build && wrangler deploy",
    "deploy:trigger": "trigger deploy",
    "dev": "concurrently --kill-others --names vite,convex,trigger,email pnpm:dev:vite pnpm:dev:convex pnpm:dev:trigger pnpm:dev:email",
    "dev:convex": "convex dev",
    "dev:trigger": "trigger dev",
    "dev:vite": "vp dev",
    "dev:email": "email dev --port 5555",
    "format": "vp format",
    "lint": "vp lint",
    "preview": "vp preview",
    "script:run": "tsx",
    "secret:bulk": "wrangler secret bulk",
    "tsr:generate": "tsr generate",
    "upload-sourcemaps": "posthog-cli sourcemap inject --directory ./dist/server/assets --project club-freedom --version 1.0.0 && posthog-cli sourcemap upload --directory ./dist/server/assets --delete-after && find ./dist/server/assets -type f -name '*.map' -delete"
  },
